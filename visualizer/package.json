{
  "name": "chendb-visualizer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Visual Database Explorer for the ChenDB engine.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bundle:engine": "node scripts/bundle-engine.mjs",
    "build:wasm": "npm run bundle:engine && VITE_CHENDB_WASM=1 tsc -b && VITE_CHENDB_WASM=1 vite build --base ./",
    "preview:wasm": "npm run build:wasm && vite preview --port 4173"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.62.0",
    "monaco-editor": "^0.52.2",
    "pyodide": "^314.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
